root = true

[*.cs]
charset = utf-8
end_of_line = lf
insert_final_newline = true
indent_style = space
indent_size = 4

# Result<T>.Success/Failure is the intentional, conventional API for expected failures.
dotnet_diagnostic.CA1000.severity = none

[**/Migrations/*.cs]
generated_code = true
dotnet_analyzer_diagnostic.severity = none
